{
  "name": "tikoeats-print",
  "productName": "Tiko Impresion",
  "version": "1.0.1",
  "description": "Tiko Impresión: imprime automáticamente comandas y tiquetes de los pedidos de Tiko.",
  "author": "Intelligsofts Systems SRL",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/qrcode": "^1.5.5",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
